{
  "name": "fairtrike",
  "version": "1.0.0",
  "private": true,
  "description": "Fairtrike — React + Node.js + PostgreSQL (one-command start)",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "npm --prefix backend start",
    "dev": "node scripts/start.mjs --dev",
    "stop": "node scripts/stop.mjs",
    "start:admin": "node backend/admin-server.js",
    "android": "node scripts/android.mjs",
    "build": "cd frontend && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "leaflet": "^1.9.4",
    "osmtogeojson": "^3.0.0-beta.5",
    "react-leaflet": "^5.0.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "ws": "^8.22.1"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "postinstall": "npm --prefix backend install --no-fund --no-audit && npm --prefix frontend install --no-fund --no-audit && npm --prefix frontend run build"
}
