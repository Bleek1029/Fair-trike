# Server
PORT=5000

# Dedicated admin dashboard port (npm run start:admin, or npm start)
ADMIN_PORT=5001
# Optional: proxy the admin SPA shell from the Vite dev server (hot-reload)
# ADMIN_SPA_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# PostgreSQL (local)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=appdev

# PostgreSQL (Neon) — uncomment and fill in your Neon connection string
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?channel_binding=require&sslmode=require"

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Optional openrouteservice API key (leave blank to use OSRM only)
ORS_API_KEY=

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_TIMEOUT_MS=15000
AI_MAX_INPUT_CHARS=1000