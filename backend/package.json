{
  "name": "fairtrike-backend",
  "version": "1.0.0",
  "allowScripts": true,
  "description": "Fairtrike backend - Node.js + Express + PostgreSQL",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "prestart": "npm ci --no-fund --no-audit",
    "start": "node start.mjs",
    "start:app": "node server.js",
    "start:admin": "node admin-server.js",
    "stop": "node ../scripts/stop.mjs",
    "dev": "node start.mjs --dev",
    "dev:app": "node --watch server.js",
    "test": "node --test \"tests/lib/**/*.test.js\"",
    "test:unit": "node --test \"tests/lib/**/*.test.js\"",
    "test:integration": "node tests/integration/runner.js",
    "create-admin": "node create-admin.js",
    "build": "npm run build --prefix ../frontend",
    "migrate": "node-pg-migrate --config migration-config.js up",
    "migrate:down": "node-pg-migrate --config migration-config.js down",
    "migrate:status": "node-pg-migrate --config migration-config.js status",
    "migrate:create": "node-pg-migrate --config migration-config.js create"
  },
  "dependencies": {
    "@google/genai": "^3.2.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "resend": "^4.0.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.1"
  }
}
