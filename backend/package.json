{
  "name": "fairtrike-backend",
  "version": "1.0.0",
  "allowScripts": true,
  "description": "Fairtrike backend - Node.js + Express + PostgreSQL",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "prestart": "npm install --no-fund --no-audit",
    "start": "node start.mjs",
    "start:app": "node server.js",
    "start:admin": "node admin-server.js",
    "stop": "node ../scripts/stop.mjs",
    "android": "node ../scripts/android.mjs",
    "dev": "node start.mjs --dev",
    "dev:app": "node --watch server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "create-admin": "node create-admin.js",
    "build": "npm run build --prefix ../frontend"
  },
  "dependencies": {
    "@google/genai": "^3.2.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "pg": "^8.13.0"
  }
}
